# ═══════════════════════════════════════════════════════════════════════════════
# SOAR Stack — Environment Variables
# Copy this file to .env and fill in your values before running init.sh
# ═══════════════════════════════════════════════════════════════════════════════
# cp .env.example .env && nano .env

# ── VM / Network ────────────────────────────────────────────────────────────
VM_IP=192.168.x.x
VM_HOSTNAME=intelbroelk

# ── System user (output of: id -u  /  id -g) ────────────────────────────────
SOAR_UID=1000
SOAR_GID=1000

# ── MISP — Threat Intelligence Platform ─────────────────────────────────────
MISP_BASEURL=https://192.168.x.x
MISP_HTTP_PORT=80
MISP_HTTPS_PORT=443
MISP_ADMIN_EMAIL=admin@soar.local
MISP_ADMIN_PASS=changeme_misp_admin

# MISP database (MariaDB)
MYSQL_USER=misp
MYSQL_PASSWORD=changeme_misp_db
MYSQL_ROOT_PASSWORD=changeme_misp_root
MYSQL_DATABASE=misp

# MISP Redis
REDIS_PASSWORD=changeme_redis

# MISP build tags (match misp-docker/misp-docker/.env)
CORE_TAG=v2.5.32
MODULES_TAG=v3.0.5
GUARD_TAG=v1.2
PHP_VER=20240924
PYPI_SETUPTOOLS_VERSION="==80.3.1"
PYPI_SUPERVISOR_VERSION="==4.2.5"

# ── Cortex — Observable Analysis Engine ─────────────────────────────────────
# Port 9001 (API direct), 8443 (HTTPS via nginx)
CORTEX_ES_PASSWORD=changeme_cortex_es
CORTEX_IMAGE_VERSION=3.1.8-1
CORTEX_DOCKER_JOB_DIR=./docker/prod1-cortex/cortex/cortex-jobs

# ── TheHive — Incident Response Platform ────────────────────────────────────
# Port 5443 (HTTPS via nginx)
THEHIVE_ES_PASSWORD=changeme_thehive_es
THEHIVE_IMAGE_VERSION=5.5.2-1

# ── Shared image versions (Cortex + TheHive stacks) ─────────────────────────
ES_IMAGE_VERSION=7.17.28
CASSANDRA_IMAGE_VERSION=4.1.8
NGINX_IMAGE_VERSION=1.27.5

# Nginx cert path (CA cert mounted into nginx containers)
NGINX_SSL_TRUSTED_CERT=/etc/nginx/certs/ca.pem

# ── Shuffle — SOAR Automation Workflows ─────────────────────────────────────
# Ports: 3001 (HTTP), 3443 (HTTPS), 5001 (backend API)
# NOTE: Additional Shuffle vars live in Shuffle/.env
SHUFFLE_OPENSEARCH_PASSWORD=changeme_shuffle_opensearch_StrongPassword321!
SHUFFLE_BACKEND_PORT=5001
SHUFFLE_FRONTEND_PORT=3001
SHUFFLE_FRONTEND_PORT_HTTPS=3443
SHUFFLE_BACKEND_HOSTNAME=shuffle-backend
SHUFFLE_OUTER_HOSTNAME=shuffle-backend

# Shuffle AI integration (optional)
AI_API_URL=
AI_MODEL=
AI_API_KEY=

# Shuffle data directories (relative to repo root)
DB_LOCATION=./Shuffle/shuffle-database
SHUFFLE_APP_HOTLOAD_LOCATION=./Shuffle/shuffle-apps
SHUFFLE_FILE_LOCATION=./Shuffle/shuffle-files

# ── ELK / Kibana (if enabled separately) ────────────────────────────────────
# ELASTIC_PASSWORD=changeme_elk

# ── MISP optional / SMTP relay ───────────────────────────────────────────────
SMARTHOST_ADDRESS=
SMARTHOST_PORT=
SMARTHOST_USER=
SMARTHOST_PASSWORD=
SMARTHOST_ALIASES=
SES_USER=
SES_PASSWORD=
SES_REGION=
SES_PORT=
SMTP_FQDN=misp-mail
